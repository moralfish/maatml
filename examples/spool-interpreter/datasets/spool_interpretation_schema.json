{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/moralfish/maatml/schemas/spool-interpretation.json",
  "title": "SpoolInterpretation",
  "description": "Canonical SpoolInterpretation emitted by the Spool Interpreter. Seven fields: a one-line summary, the outcome, and the operator-facing cause and fix.",
  "type": "object",
  "required": [
    "summary",
    "status",
    "rootCause",
    "confidence"
  ],
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "failed",
        "abended",
        "skipped",
        "running"
      ]
    },
    "returnCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "rootCause": {
      "type": "string",
      "minLength": 1
    },
    "suggestedFix": {
      "type": [
        "string",
        "null"
      ],
      "description": "Operator-facing remediation. Required when status != 'completed'; null for a completed job."
    },
    "failureCategory": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "dataset_resolution_failure",
        "allocation_failure",
        "permission_or_security_failure",
        "jcl_syntax_failure",
        "utility_parameter_failure",
        "execution_abend",
        "scheduler_or_environment_issue",
        "other"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  }
}
